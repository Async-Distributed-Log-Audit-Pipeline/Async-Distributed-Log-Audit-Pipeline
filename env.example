# Copy to `.env` in the repo root (same folder as docker-compose.yml).
# Every value is optional - the defaults shown here are what compose uses.
# CHANGE ALL CREDENTIALS before exposing this stack beyond your own machine.

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=log-ingestion-queue
RABBITMQ_DLQ_NAME=log-ingestion-dlq
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- MongoDB ------------------------------------------------------------------
MONGO_DB_NAME=log_analytics
MONGO_COLLECTION=ingestions
MONGO_PORT=27017

# --- MinIO / S3 ---------------------------------------------------------------
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD are used for both the MinIO server and
# the S3 access key/secret that the API and worker use.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=raw-logs
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Pin this to a specific tag for reproducible builds.
MINIO_IMAGE=pgsty/minio:latest

# --- Log Ingestion API --------------------------------------------------------
API_PORT=8000
# Comma-separated origins, or * for any. Example: http://localhost:8081
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=10485760

# --- Log Worker ---------------------------------------------------------------
RABBITMQ_HEARTBEAT=600
PREFETCH_COUNT=1
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
MAX_SKIPPED_RATIO=0.5
DEBUG_PROCESSING_DELAY_SECONDS=0

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=8081
# Called by the BROWSER, so it must be host-reachable (not an internal
# hostname). Baked in at build time: changing it requires `--build`.
VITE_API_BASE_URL=http://localhost:9191

# --- SMS backend (only used with --profile sms-backend) -----------------------
SMS_DB_PASSWORD=Himebw115
GATEWAY_PORT=9191
EUREKA_PORT=8761
