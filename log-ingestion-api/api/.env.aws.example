# ============================================================
# AWS ECS / Cloud Environment Configuration for Log Ingestion API
# Rename this file to .env or inject these variables into ECS Task Definition
# ============================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=10485760

# Messaging Queue: Switch to "sqs" for AWS deployment
QUEUE_TYPE=sqs
SQS_QUEUE_URL=https://sqs.<REGION>.amazonaws.com/<ACCOUNT_ID>/log-ingestion-queue

# Database: Switch to "dynamodb" for AWS deployment
DB_TYPE=dynamodb
DYNAMODB_TABLE_NAME=ingestions

# Amazon S3 Object Storage Configuration
# Set S3_ENDPOINT_URL to empty for official AWS S3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=raw-logs
S3_REGION=us-east-1

# Optional: Only needed if running locally outside AWS without IAM Role:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
