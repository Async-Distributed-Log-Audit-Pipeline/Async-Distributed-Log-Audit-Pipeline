# =============================================================
# Root .env.example — Consolidated environment variables
# for the Async Distributed Log & Audit Analytics Pipeline.
#
# Copy to .env and override any value before running:
#   cp .env.example .env
#
# Used with root docker-compose.yml. When the full stack runs
# via Docker Compose, service names are used as hostnames
# (rabbitmq, mongodb, minio, log-ingestion-api). The localhost
# values below are for running individual components directly
# on your host machine (outside Docker).
# =============================================================


# ─────────────────────────────────────────────────────────────
# RabbitMQ
# Used by: log-worker, log-ingestion-api, db (seed_services.py)
# ─────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Main ingestion queue name — must be identical across all services
RABBITMQ_QUEUE_NAME=log-ingestion-queue
# Dead-letter queue — used by log-worker only
RABBITMQ_DLQ_NAME=log-ingestion-dlq


# ─────────────────────────────────────────────────────────────
# MongoDB
# Used by: log-worker, log-ingestion-api, db (all scripts)
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=log_analytics
MONGO_COLLECTION=ingestions


# ─────────────────────────────────────────────────────────────
# MinIO / S3-Compatible Object Storage
# Used by: log-worker, log-ingestion-api, db (seed_services.py)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=raw-logs
S3_REGION=us-east-1


# ─────────────────────────────────────────────────────────────
# Log Ingestion API (FastAPI — log-ingestion-api/api/)
# Used by: log-ingestion-api only
# ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=10485760


# ─────────────────────────────────────────────────────────────
# Log Worker tuning (log-worker/)
# Used by: log-worker only
# ─────────────────────────────────────────────────────────────
# Heartbeat interval in seconds for the pika blocking connection
RABBITMQ_HEARTBEAT=600
# Maximum messages delivered to the worker before ACK is required
PREFETCH_COUNT=1
# Unique identifier for each worker instance in structured logs
WORKER_ID=worker-local-1
# Demo-only artificial processing delay in seconds (set 0 in production)
DEBUG_PROCESSING_DELAY_SECONDS=0

# Retry & Dead-Letter Queue policy
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60

# Parser thresholds
MAX_SKIPPED_RATIO=0.5


# ─────────────────────────────────────────────────────────────
# Dashboard (Streamlit — dashboard/)
# Used by: dashboard only
# ─────────────────────────────────────────────────────────────
# In Docker Compose this MUST be http://log-ingestion-api:8000
# For running dashboard locally against a host-bound API: http://localhost:8000
API_BASE_URL=http://localhost:8000
# Set to true to display synthetic mock data without a live API connection
DEMO_MODE=false
