# ============================================================
# AWS / Cloud Environment Configuration for Log Worker Service
# Rename this file to .env when running or testing with AWS services
# ============================================================

# Database: Set to dynamodb for AWS deployment
DB_TYPE=dynamodb
DYNAMODB_TABLE_NAME=ingestions

# Amazon S3 Object Storage Configuration
# Set S3_ENDPOINT_URL to empty for official AWS S3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=raw-logs
S3_REGION=us-east-1

# Worker tuning
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
MAX_SKIPPED_RATIO=0.5
