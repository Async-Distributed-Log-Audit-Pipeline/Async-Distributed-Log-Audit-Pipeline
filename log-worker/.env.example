# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=log-ingestion-queue
# Dead Letter Queue name for unprocessable or retries-exhausted messages (default: log-ingestion-dlq)
RABBITMQ_DLQ_NAME=log-ingestion-dlq

# Consumer Tuning & Heartbeat
# Heartbeat interval in seconds for pika blocking connection (default: 600)
RABBITMQ_HEARTBEAT=600
# Prefetch count for fair queue load balancing across concurrent workers (default: 1)
PREFETCH_COUNT=1
# Unique identifier for worker logging (default: hostname)
WORKER_ID=worker-local-1
# Demo-only artificial delay in seconds to test mid-job worker crashes (default: 0)
DEBUG_PROCESSING_DELAY_SECONDS=0

# Retry & Dead-Letter Queue Policy (Phase 6)
# Maximum number of retry attempts for transiently failed jobs before routing to DLQ (default: 3)
MAX_RETRIES=3
# Base exponential backoff delay in seconds for retry 1 (default: 2)
RETRY_BASE_DELAY_SECONDS=2
# Maximum cap for exponential backoff delay in seconds (default: 60)
RETRY_MAX_DELAY_SECONDS=60

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=log_analytics
MONGO_COLLECTION=ingestions

# S3 Object Storage Configuration (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=raw-logs
S3_REGION=us-east-1

# Parser Thresholds
# Maximum tolerated ratio of malformed/skipped lines before failing ingestion (default: 0.5)
MAX_SKIPPED_RATIO=0.5
