# ============================================================
# AWS ECS / Cloud Environment Configuration for Streamlit Dashboard
# Rename this file to .env or inject these variables into ECS Task Definition
# ============================================================

# Point to your deployed FastAPI Gateway in ECS (Public IP or ALB/DNS)
API_BASE_URL=http://<API_PUBLIC_IP_OR_DNS>:8000

# Set to false to interact with live API and AWS cloud services
DEMO_MODE=false
